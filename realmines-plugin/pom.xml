<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>joserodpt</groupId>
    <artifactId>RealMinesPlugin</artifactId>
    <version>1.9</version>
    <packaging>jar</packaging>

    <parent>
        <groupId>joserodpt.realmines</groupId>
        <artifactId>realmines-parent</artifactId>
        <version>1.9</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <name>RealMinesPlugin</name>
    <description>Simple, Easy to Use and Configurable Mines plugin.</description>

    <properties>
        <!-- the build time, stamped into build.properties for the console to show. maven.build.timestamp
             is always UTC and can't be filtered into resources itself, so it goes through a property -->
        <maven.build.timestamp.format>yyyy-MM-dd'T'HH:mm:ss'Z'</maven.build.timestamp.format>
        <build.time>${maven.build.timestamp}</build.time>
        <maven.compiler.release>16</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- JitPack coordinate for joserodpt/RealPermissions. Swap for a tag (e.g.
             v0.4.4) once the upstream repo has one; commit hashes are stable too. -->
        <realpermissions.version>1e7015a05e</realpermissions.version>
        <lamp.version>4.0.0-rc.18</lamp.version>
        <bstats.version>3.2.1</bstats.version>
    </properties>

    <build>
        <finalName>realmines-${project.version}</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <compilerArgs>
                        <!-- Lamp names command arguments after the method parameters, so the
                             usage strings and <name> placeholders depend on these surviving. -->
                        <arg>-parameters</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.1</version>

                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>

                        <configuration>
                            <!-- Replace original JAR instead of keeping original-..jar -->
                            <outputFile>${project.build.directory}/${project.build.finalName}.jar</outputFile>
                            <shadedArtifactAttached>false</shadedArtifactAttached>
                            <minimizeJar>true</minimizeJar>

                            <!-- Include only the exact dependencies you want -->
                            <artifactSet>
                                <includes>
                                    <include>dev.dejvokep:boosted-yaml</include>
                                    <include>io.github.revxrsal:lamp.common</include>
                                    <include>io.github.revxrsal:lamp.bukkit</include>
                                    <include>io.github.revxrsal:lamp.brigadier</include>
                                    <include>joserodpt:RealMinesAPI</include>
                                    <include>com.j256.ormlite:ormlite-core</include>
                                    <include>com.j256.ormlite:ormlite-jdbc</include>
                                    <include>com.github.joserodpt:RealUtils</include>
                                    <include>io.github.projectunified:*</include>
                                    <include>org.bstats:*</include>
                                </includes>
                            </artifactSet>

                            <!-- Relocations -->
                            <relocations>
                                <!-- com.mojang.brigadier is deliberately not relocated: those classes
                                     come from the server, we only talk to them. -->
                                <relocation>
                                    <pattern>revxrsal.commands</pattern>
                                    <shadedPattern>joserodpt.realmines.shaded.lamp</shadedPattern>
                                </relocation>

                                <relocation>
                                    <pattern>dev.dejvokep.boostedyaml</pattern>
                                    <shadedPattern>joserodpt.realmines.shaded.boostedyaml</shadedPattern>
                                </relocation>

                                <relocation>
                                    <pattern>joserodpt.realutils</pattern>
                                    <shadedPattern>joserodpt.realmines.shaded.realutils</shadedPattern>
                                </relocation>
                                <!-- Also rewrites the manager class names RealUtils loads by name. -->
                                <relocation>
                                    <pattern>io.github.projectunified.unidialog</pattern>
                                    <shadedPattern>joserodpt.realmines.shaded.unidialog</shadedPattern>
                                </relocation>
                                <!-- bStats asks for its package to be relocated, so plugins don't share one copy. -->
                                <relocation>
                                    <pattern>org.bstats</pattern>
                                    <shadedPattern>joserodpt.realmines.shaded.bstats</shadedPattern>
                                </relocation>
                            </relocations>

                            <!-- Remove all META-INF contents -->
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/**</exclude>
                                        <exclude>org/jetbrains/annotations/**</exclude>
                                    </excludes>
                                </filter>
                                <!-- ORMLite resolves DatabaseType/field converters reflectively, so minimizeJar
                                     would strip classes that are only ever reached at runtime. Keep them all. -->
                                <filter>
                                    <artifact>com.j256.ormlite:*</artifact>
                                    <includes>
                                        <include>**</include>
                                    </includes>
                                </filter>
                                <!-- Lamp reaches its Bukkit/Brigadier hooks and parameter types through
                                     reflection and version probing, so minimizeJar can't see they are used. -->
                                <filter>
                                    <artifact>io.github.revxrsal:*</artifact>
                                    <includes>
                                        <include>**</include>
                                    </includes>
                                </filter>
                                <!-- The dialog managers and RealUtils' Paper text are only ever loaded by name. -->
                                <filter>
                                    <artifact>com.github.joserodpt:RealUtils</artifact>
                                    <includes>
                                        <include>**</include>
                                    </includes>
                                </filter>
                                <filter>
                                    <artifact>io.github.projectunified:*</artifact>
                                    <includes>
                                        <include>**</include>
                                    </includes>
                                </filter>
                                <!-- Same problem in our own API: the SkullCreator version patches are only
                                     reached through Class.forName, so minimizeJar dropped all three and every
                                     player head silently came out with no texture. This is our own code, not a
                                     library to trim, so keep the whole module. -->
                                <filter>
                                    <artifact>joserodpt:RealMinesAPI</artifact>
                                    <includes>
                                        <include>**</include>
                                    </includes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
    </build>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <repository>
            <id>spigotmc-repo</id>
            <url>https://hub.spigotmc.org/nexus/content/repositories/snapshots/</url>
        </repository>
        <repository>
            <id>sonatype</id>
            <url>https://oss.sonatype.org/content/groups/public/</url>
        </repository>
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
        <repository>
            <id>enginehub-maven</id>
            <url>https://maven.enginehub.org/repo/</url>
        </repository>
        <repository>
            <id>placeholderapi</id>
            <url>https://repo.extendedclip.com/content/repositories/placeholderapi/</url>
        </repository>
        <repository>
            <id>minecraft-repo</id>
            <url>https://libraries.minecraft.net/</url>
        </repository>
        <repository>
            <id>codemc-releases</id>
            <url>https://repo.codemc.io/repository/maven-releases/</url>
        </repository>
        <repository>
            <id>codemc-snapshots</id>
            <url>https://repo.codemc.io/repository/maven-snapshots/</url>
        </repository>
    </repositories>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.intellectualsites.bom</groupId>
                <artifactId>bom-newest</artifactId> <!--  Ref: https://github.com/IntellectualSites/bom -->
                <version>1.42</version>
                <scope>import</scope>
                <type>pom</type>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.spigotmc</groupId>
            <artifactId>spigot-api</artifactId>
            <version>1.14-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>
        <!-- lamp.bukkit declares lamp.common and lamp.brigadier at runtime scope, which is enough
             for shading but leaves them off the compile classpath, so lamp.common is repeated here.
             lamp.brigadier is only ever reached at runtime, so it does not need the same. -->
        <dependency>
            <groupId>io.github.revxrsal</groupId>
            <artifactId>lamp.common</artifactId>
            <version>${lamp.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.revxrsal</groupId>
            <artifactId>lamp.bukkit</artifactId>
            <version>${lamp.version}</version>
        </dependency>
        <dependency>
            <groupId>me.clip</groupId>
            <artifactId>placeholderapi</artifactId>
            <version>2.11.6</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.fastasyncworldedit</groupId>
            <artifactId>FastAsyncWorldEdit-Core</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>com.fastasyncworldedit</groupId>
            <artifactId>FastAsyncWorldEdit-Bukkit</artifactId>
            <scope>provided</scope>
            <exclusions>
                <exclusion>
                    <artifactId>FastAsyncWorldEdit-Core</artifactId>
                    <groupId>*</groupId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>joserodpt</groupId>
            <artifactId>RealMinesAPI</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- GUIs, text, items, configs, dialogs and the chat prompt, shaded and relocated below. It brings UniDialog's Spigot and
             Paper backends with it, picked between at runtime. -->
        <dependency>
            <groupId>com.github.joserodpt</groupId>
            <artifactId>RealUtils</artifactId>
            <version>${realutils.version}</version>
        </dependency>
        <dependency>
            <groupId>org.bstats</groupId>
            <artifactId>bstats-bukkit</artifactId>
            <version>${bstats.version}</version>
        </dependency>
        <!-- Pinned to bstats-bukkit's version: FastAsyncWorldEdit brings an older bstats-base
             that would otherwise be shaded instead, and fail to enable with a NoSuchMethodError. -->
        <dependency>
            <groupId>org.bstats</groupId>
            <artifactId>bstats-base</artifactId>
            <version>${bstats.version}</version>
        </dependency>
        <dependency>
            <groupId>com.github.MilkBowl</groupId>
            <artifactId>VaultAPI</artifactId>
            <version>1.7</version>
            <scope>compile</scope>
        </dependency>
        <!-- Soft hook: only touched when the RealPermissions plugin is present at
             runtime, so it stays provided and is never shaded in. -->
        <dependency>
            <groupId>com.github.joserodpt.RealPermissions</groupId>
            <artifactId>realpermissions-api</artifactId>
            <version>${realpermissions.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>
